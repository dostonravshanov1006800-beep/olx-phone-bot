# .env для запуска на VPS (python bot/main.py --loop или docker compose)
# На GitHub Actions эти значения лежат в Secrets репозитория.

TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
SCAN_INTERVAL_SEC=120
SCAN_PAGES=2
MAX_ADS_PER_CYCLE=30
DEAL_MIN_DISCOUNT_PCT=15
HOT_DISCOUNT_PCT=25
SUSPICIOUS_BELOW_PCT=40
SUSPICIOUS_MODE=skip
FALLBACK_USD_RATE=11850
LOG_LEVEL=INFO
